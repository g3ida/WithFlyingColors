<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>WithFlyingColors</RootNamespace>
    <!-- Required for some nuget packages to work -->
    <!-- godotengine/godot/issues/42271#issuecomment-751423827 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- To show generated files -->
    <!-- <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles> -->
    <!--
      <CompilerGeneratedFilesOutputPath>.generated</CompilerGeneratedFilesOutputPath>
    -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Title>WithFlyingColors</Title>
    <Version>1.0.0</Version>
    <Description>WithFlyingColors</Description>
    <Copyright>© 2023 G3idaGames</Copyright>
    <Authors>G3ida</Authors>
    <Company>G3idaGames</Company>
    <!-- Catch compiler-mismatch issues with the Introspection generator -->
    <WarningsAsErrors>CS9057</WarningsAsErrors>
    <NoWarn>$(NoWarn);CA1805</NoWarn>
    <SkipTests Condition="'$(SKIP_TESTS)' != ''">true</SkipTests>
    <RunTests>false</RunTests>
  </PropertyGroup>
  <!--
    One switch owns the test tree: the packages, the sources and the entry point in Main
    all read RunTests, so no configuration can reference a test package it does not compile
    against. Set SKIP_TESTS to build Debug without any of it.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(SkipTests)' != 'true'">
    <RunTests>true</RunTests>
    <DefineConstants>$(DefineConstants);RUN_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Lets the source generators resolve node paths against the scenes at compile time. -->
    <AdditionalFiles Include="**/*.tscn" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunTests)' == 'true'">
    <!-- Test dependencies go here! -->
    <!-- Dependencies added here will not be included in release builds. -->
    <PackageReference Include="Chickensoft.GoDotTest" Version="2.0.43" />
    <PackageReference Include="NUnit" Version="5.0.0-beta.1" />
    <!-- Used to drive test scenes when testing visual code -->
    <PackageReference Include="Chickensoft.GodotTestDriver" Version="3.1.79" />
    <!-- Bring your own assertion library for tests! -->
    <!-- We're using Shouldly for this example, but you can use anything. -->
    <PackageReference Include="Shouldly" Version="5.0.0-preview.2" />
    <!-- LightMock is a mocking library that works without reflection. -->
    <PackageReference Include="LightMock.Generator" Version="1.2.3" />
    <!-- LightMoq is a Chickensoft package which makes it more like Moq. -->
    <PackageReference Include="LightMoq" Version="0.1.0" />
    <!--
      LightMock cannot generate a mock for any Chickensoft.GodotNodeInterfaces interface:
      Godot's own Node.Atr takes a parameter named "context", which shadows the generator's
      invocation context, so the generated file does not compile. Moq proxies at runtime
      and does not care.
    -->
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>
  <ItemGroup>
    <!-- Production dependencies go here! -->
    <PackageReference Include="Chickensoft.GodotNodeInterfaces" Version="3.0.30" />
    <PackageReference Include="Chickensoft.Introspection" Version="3.0.3" />
    <PackageReference Include="Chickensoft.Introspection.Generator" Version="3.0.3" PrivateAssets="all" OutputItemType="analyzer" />
    <PackageReference Include="Chickensoft.AutoInject" Version="2.13.30" PrivateAssets="all" />
    <PackageReference Include="Chickensoft.Sync" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(RunTests)' != 'true'">
    <Compile Remove="test/**/*.cs" />
    <EmbeddedResource Remove="test/**/*" />
    <None Remove="test/**/*" />
    <AdditionalFiles Remove="test/**/*" />
  </ItemGroup>
</Project>
